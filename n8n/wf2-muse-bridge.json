    {
      "parameters": {
        "jsCode": "// Return the pending queue fetched from WF1's queue-ops endpoint.\n// The HTTP node output is the JSON returned by that endpoint: {pending: [...]}.\n// Do NOT clear the queue on read - acking happens via the outbox flow.\nconst data = $input.first().json;\nreturn [{ json: { pending: data.pending || [] } }];"
      },
      "id": "9236c012-dd7d-476c-90e2-0746f36472de",
      "name": "Code in JavaScript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        352,
        16
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "muse-outbox-<TOKEN_A>",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "8396a92f-7b12-410c-b2c9-297b72fe4f68",
      "name": "Muse Outbox",
      "webhookId": "6da7e2fd-7f1d-409b-b97e-290febb5607a",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        448,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "// Build one send-request item per outbox item.\n// body.items = [{wid, action: 'reply'|'escalate', to, message, file_url?, file_type?}]\n// file_type: 'image' -> /send/image, anything else -> /send/file\nconst input = $input.first().json;\nconst body = (input.body && typeof input.body === 'object') ? input.body : input;\nconst items = body.items || [];\nconst out = [];\nfor (const it of items) {\n  let phone = it.action === 'escalate' ? '<YOUR_OWNER_NUMBER>@s.whatsapp.net' : String(it.to || '');\n  if (phone && phone.indexOf('@') === -1) phone += '@s.whatsapp.net';\n  out.push({ json: {\n    wid: it.wid || null,\n    action: it.action || 'reply',\n    phone: phone,\n    message: String(it.message || ''),\n    file_url: it.file_url ? String(it.file_url) : '',\n    file_type: it.file_type === 'image' ? 'image' : 'file'\n  }});\n}\nreturn out;"
      },
      "id": "74f6830d-b0d4-434d-9632-bf1eacda17bf",
      "name": "Build send requests",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
