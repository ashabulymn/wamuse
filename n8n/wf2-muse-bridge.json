    {
      "parameters": {
        "jsCode": "// Collect the wids that were just sent so the next node can ack them\n// from WF1's queue. Emits ONE item: {mode:'ack', wids, sent}.\nconst built = $('Build send requests').all();\nconst wids = [];\nfor (const b of built) {\n  const wid = b.json && b.json.wid;\n  if (wid) wids.push(wid);\n}\nreturn [{ json: { mode: 'ack', wids: wids, sent: wids.length } }];"
      },
